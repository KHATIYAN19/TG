# Google sign-in (Prep Buddy Arena). Same value as the backend GOOGLE_CLIENT_ID. Empty = Google button hidden.
VITE_GOOGLE_CLIENT_ID=

# Memories: which payment gateway the pay page uses. cashfree (default) | razorpay | payu | mock
# The gateway must also be switched on in Admin > Memories > Settings. If it isn't, the server's default is used.
VITE_MEMORIES_PAYMENT_GATEWAY="cashfree"
